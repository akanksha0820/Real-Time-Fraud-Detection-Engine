FRAUD_MODEL_PATH=artifacts/model.joblib
FRAUD_METADATA_PATH=artifacts/model_metadata.json
REDIS_URL=redis://localhost:6379/0
FRAUD_STATE_BACKEND=memory
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTION_TOPIC=transactions
KAFKA_SCORE_TOPIC=risk-scores
KAFKA_DLQ_TOPIC=transactions-dlq
POSTGRES_DSN=postgresql://fraud:fraud@localhost:5433/fraud
FRAUD_ENV=development
FRAUD_API_KEY=replace-with-a-random-64-character-secret
FRAUD_AUTH_DISABLED=false
FRAUD_RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
